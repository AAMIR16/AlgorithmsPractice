using System;
using System.Collections.Generic;
using System.Linq;

class Program {
  public static void Main(string[] args)
  {

    int[] givenArray = { 1, 2, 3, 4, 10, 6, 0, 8, 3, 2 };
    int size = 4;
    int maxSum = GetMaxSumofArray(givenArray, size);
    Console.WriteLine($"Max sum is {maxSum}");

  }

  static int GetMaxSumofArray(int[] arr, k)
  {
    if (arr.Length <= 0) return 0;

    //Sliding window

    int windowSum = 0;
    int maxSum = 0;

    //create the first window and calculate the sum
    for (int i = 0; i < k; i++)
    {
      windowSum = windowSum + arr[i];

    }
    maxSum = windowSum;

    // slide the window
    for (int i = k; i < arr.Length; i++)
    {
      windowSum = (windowSum + arr[i]) - arr[i - k];
      Console.WriteLine($"total for the window is {windowSum}");
      maxSum = Math.Max(maxSum, windowSum);
    }
    
    return maxSum;
  }
}